# Skopiuj ten plik do .env.local i wstaw realne wartości z Supabase
# (Supabase Dashboard -> Project Settings -> API)
#
# UWAGA: strona publiczna to eksport statyczny (output: 'export'), więc te
# wartości są WKOMPILOWANE w HTML i JS w momencie `npm run build` — nie są
# czytane później na serwerze. Build z wartościami poniżej wypuszcza katalog
# out/ nadający się tylko do podglądu. Hook `prebuild` (scripts/check-build-env.mjs)
# zablokuje taki build; świadomy podgląd: ALLOW_PLACEHOLDER_BUILD=1 npm run build

NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=twoj-anon-public-key

# Adres produkcyjny — trafia do canonicali, sitemap.xml, robots.txt i Open Graph.
# Do pracy lokalnej najlepiej ZAKOMENTOWAĆ: lib/seo/site.ts ma fallback
# https://airsquad.pl, więc podgląd nie rozjeżdża się z produkcją.
# NEXT_PUBLIC_SITE_URL=https://airsquad.pl
